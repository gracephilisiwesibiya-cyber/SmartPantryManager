<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/tvRecipeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipe Name"
        android:textColor="@color/pantry_dark_green"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="✓ You have all the required ingredients"
        android:textColor="@color/pantry_medium_green"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnViewRecipe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/pantry_green"
        android:text="VIEW RECIPE"
        android:textColor="@color/white"
        android:textStyle="bold" />

</LinearLayout>